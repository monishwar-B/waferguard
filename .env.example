# Copy to .env and change every value before `docker compose up -d`
WG_JWT_SECRET=replace-with-64-random-characters
WG_ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
GRAFANA_PASSWORD=replace-me
# Port for plain HTTP access (http://<this-pc>:8000)
WG_PORT=8000
# HTTPS profile only: public DNS name (automatic certificate) or localhost / LAN IP (self-signed)
WG_DOMAIN=localhost
